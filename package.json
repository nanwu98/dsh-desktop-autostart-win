{
  "name": "dsh-desktop-autostart-win",
  "version": "1.0.0",
  "description": "Windows sign-in autostart for the DeepSeek Harness desktop app: one Settings switch, one per-user startup entry, and automatic detection of the installed app.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "windows",
    "autostart",
    "startup",
    "cordis"
  ],
  "license": "MIT",
  "author": "nanwu98",
  "homepage": "https://github.com/nanwu98/dsh-desktop-autostart-win#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanwu98/dsh-desktop-autostart-win.git"
  },
  "bugs": {
    "url": "https://github.com/nanwu98/dsh-desktop-autostart-win/issues"
  },
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/helpers.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
